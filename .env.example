# Sanjeevni-AI - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file (add to .gitignore)

# ============================================
# Firebase Configuration (REQUIRED for online mode)
# ============================================
# Path to your Firebase service account JSON file
# Download from: Firebase Console -> Project Settings -> Service Accounts
FIREBASE_JSON_PATH=/path/to/your/firebase-adminsdk.json

# Firebase Realtime Database URL
# Format: https://YOUR-PROJECT.firebaseio.com
FIREBASE_RTD_URL=https://your-project.firebaseio.com

# Firebase mode: "firestore", "realtime", or "both"
FIREBASE_DB_TYPE=both

# Realtime Database path written by the Raspberry Pi
IOT_FIREBASE_PATH=devices/ai-power-structural-health-m-s/readings

# ============================================
# System Dependencies (Windows only)
# ============================================
# Path to Poppler installation for PDF-to-image conversion
# Download from: https://github.com/oschwartz10612/poppler-windows/releases/
POPPLER_PATH=C:/Program Files/poppler-24.08.0/Library/bin

# Path to Tesseract OCR installation
# Download from: https://github.com/UB-Mannheim/tesseract/wiki
TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe

# ============================================
# Server Configuration
# ============================================
# Flask API server host and port
FLASK_HOST=127.0.0.1
FLASK_PORT=5100
FLASK_ENV=production

# Browser origins allowed to call the backend
ALLOWED_ORIGINS=http://localhost:3100,https://ai-power-structural-health-m-s.web.app

# ============================================
# Logging Configuration
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location
LOG_FILE=logs/healthcare_app.log

# ============================================
# Application Behavior
# ============================================
# Default mode: "online" or "offline"
DEFAULT_MODE=online

# Maximum local database size (in records)
MAX_LOCAL_DB_SIZE=10000

# Sync interval (in seconds) for offline-to-Firebase sync
SYNC_INTERVAL=300

# ============================================
# Security
# ============================================
# Required for private IoT reads and saving predictions.
API_KEY=your-api-key-here

# NVIDIA NIM AI Doctor (keep the real key only in local/hosting secrets)
NVIDIA_API_KEY=your-nvidia-api-key-here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_FALLBACK_MODELS=nvidia/nemotron-mini-4b-instruct
NVIDIA_TIMEOUT_SECONDS=8

# Secret key for session management
SECRET_KEY=your-secret-key-here
